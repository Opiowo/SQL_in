{
  "name": "sql-in",
  "displayName": "SQL IN() Formatter",
  "description": "Turn a list of values, one per line, into a SQL IN() statement — with configurable trimming, empty-line skipping, and de-duplication.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.72.0"
  },
  "author": {
    "name": "Opiowo"
  },
  "publisher": "Opiowo",
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "SQL", "SQL IN", "IN Statement", "IN", "IN()", "SQL clause", "Where clause"
  ],
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#383838",
    "theme": "dark"
  },
  "activationEvents": [
    "onCommand:sql-in.sqlin"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sql-in.sqlin",
        "title": "SQL IN() Statement"
      }
    ],
    "configuration": {
      "title": "SQL IN() Formatter",
      "properties": {
        "sqlIn.trimValues": {
          "type": "boolean",
          "default": true,
          "description": "Trim leading and trailing whitespace from each value before quoting."
        },
        "sqlIn.skipEmptyLines": {
          "type": "boolean",
          "default": true,
          "description": "Skip lines that are empty or contain only whitespace."
        },
        "sqlIn.removeDuplicates": {
          "type": "boolean",
          "default": false,
          "description": "Remove duplicate values, keeping the first occurrence."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Opiowo/SQL_in.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.72.0",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "eslint": "^8.24.0",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "typescript": "^4.8.4",
    "@vscode/test-electron": "^2.1.5"
  }
}
